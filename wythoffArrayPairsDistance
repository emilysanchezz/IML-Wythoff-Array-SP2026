import numpy as np
import math
import random

def wythoff_pair(n): #n reps the row (row_pair) (first 2)
    phi = (1 + math.sqrt(5))/2
    a_n = math.floor(math.floor(n*phi)*phi)
    b_n = math.floor(math.floor(n*phi)*phi**2)
    return a_n, b_n

def wyth_row(row, column=20):  # total_length = desired number of elements in the row, 10 can be default
    lower_b, upper_b = wythoff_pair(row)
    row = [lower_b, upper_b]
    while len(row) < column:
        row.append(row[-2] + row[-1])
    return row

def wyth_array(row, column): 
    arr = []
    for i in range(1, row+1):
        r = wyth_row(i, column)
        arr.append(r)
    return arr

def whole_wyth_array(row_upto = 10, col_upto = 10): #10x10 wyth array
    arr = []
    for i in range(1, row_upto+1):
        r = wyth_row(i, col_upto)
        arr.append(r)
    return arr

def wyth_col(col, row=10):
    arr = []
    for i in range(1, row+1):
        c = wyth_row(i, col + 1)[col]
        arr.append(c)
    return arr

def wythoff_location(arr):
    location = {}
    for i in range(len(arr)):
        for j in range(len(arr[i])):
            location[arr[i][j]] = (i+1, j+1)
    return location

def dist(a, b, loc):
    r1, c1 = loc[a]
    r2, c2 = loc[b]
    return abs(r1 - r2) + abs(c1 - c2)

def adjacent_pair_j_two(whole_arr, sub_arr, col):
    pairs = []
    location = wythoff_location(whole_arr)

    for row in range(len(sub_arr)):
        a = sub_arr[row][col]
        b = sub_arr[row][col + 1]

        original_a_pos = location[a]
        original_b_pos = location[b]
        original_dist = dist(a, b, location)

        new_a = a + 1
        new_b = b + 1


        updated_a_pos = location[new_a]
        updated_b_pos = location[new_b]
        updated_dist = dist(new_a, new_b, location)

        diff_dist = abs(updated_dist - original_dist)

        pairs.append({"original_pair": (a, b),
            "original_positions": (original_a_pos, original_b_pos),
            "original_distance": original_dist,
            "shifted_pair": (new_a, new_b),
            "updated_positions": (updated_a_pos, updated_b_pos),
            "updated_distance": updated_dist,
            "distance_difference": diff_dist
            })

    return pairs

def distances(observing, col):
    obs_rows = wyth_array(observing, col+2)
    obs_arr = whole_wyth_array(observing + 300,col + 30) #fixing for future to meet bounds all times
    outputted_dist = []
    results = adjacent_pair_j_two(obs_arr, obs_rows, col)
    for result in results:
        for key,val in result.items():
            if key == "updated_distance":
                outputted_dist.append(val)
    return outputted_dist


